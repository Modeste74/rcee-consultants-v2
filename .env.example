FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-value

# Postgres connection string. Locally you can leave this unset to fall back
# to sqlite (see app/config.py). In production this is required.
DATABASE_URL=postgresql://user:password@localhost:5432/rcee_consultants

# Email (for inquiry notifications + password reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
ADMIN_NOTIFICATION_EMAIL=mum-real-inbox@example.com

# Cloud image storage (Cloudinary free tier works well for this scale)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp button - international format, no + or spaces, e.g. 2547XXXXXXXX
WHATSAPP_NUMBER=
